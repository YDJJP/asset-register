# =================================================================
# Asset Register 环境变量配置
# =================================================================

# 存储目录（在 Docker 中建议映射为 /app/data）
DATA_DIR=/app/data

# WebAuthn / Passkey 凭据显示名称
RP_NAME=Asset Register 资产登记

# WebAuthn Relying Party ID（域名，不包含协议与端口号）
# 本地测试时无需填写（自动设为 localhost）；生产环境建议填写您的具体域名，例如：
# RP_ID=assets.example.com

# WebAuthn Expected Origin（完整的 Web 访问地址）
# 生产环境例如：
# RP_ORIGIN=https://assets.example.com

# 密钥（留空时系统会在 data/.secret_key 中自动生成并持久化）
# SECRET_KEY=your-random-32-character-secret-key

# 会话有效天数（默认 30 天）
SESSION_EXPIRE_DAYS=30

